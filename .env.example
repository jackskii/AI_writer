# Database Configuration
DB_NAME=novel_ai_db
DB_USER=novel_user
DB_PASSWORD=novel_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8001
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# DeepSeek API Configuration
# Note: API keys are now stored per-user in account settings
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Frontend Configuration
FRONTEND_PORT=3000

# For local development, use localhost:
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=http://localhost:8001/api

# For GCP/server deployment, use your server's public IP:
# FRONTEND_URL=http://YOUR_SERVER_IP:3000
# VITE_API_URL=http://YOUR_SERVER_IP:8001/api

# Default (binds to all interfaces - works for both local and server):
FRONTEND_URL=http://0.0.0.0:3000
VITE_API_URL=http://0.0.0.0:8001/api
